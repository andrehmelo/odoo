<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Action for Active Check-Ins (for Check-Out button) - MUST BE DEFINED FIRST -->
    <record id="action_vehicle_checkin_active" model="ir.actions.act_window">
        <field name="name">Active Check-Ins - Select to Check-Out</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">vehicle.checkin</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_filter_checked_in': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No active check-ins!
            </p>
            <p>
                All vehicles have been checked out. Use the Check-In button to assign a vehicle to a driver.
            </p>
        </field>
    </record>
    
    <!-- Main Dashboard Action - Client Action -->
    <record id="action_vehicle_checkin_dashboard_client" model="ir.actions.client">
        <field name="name">Vehicle Check-In Dashboard</field>
        <field name="tag">vehicle_checkin_dashboard</field>
        <field name="target">main</field>
    </record>
</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Extend Vehicle Form to Add Driver History Tab -->
    <record id="view_vehicle_form_driver_history" model="ir.ui.view">
        <field name="name">vehicle.vehicle.form.driver.history</field>
        <field name="model">vehicle.vehicle</field>
        <field name="inherit_id" ref="vehicle_manager.view_vehicle_form"/>
        <field name="arch" type="xml">
            <!-- Add Driver History page after Intervention History -->
            <xpath expr="//page[@name='intervention_history']" position="after">
                <page name="driver_history" string="Driver History">
                    <field name="checkin_ids"/>
                </page>
            </xpath>
        </field>
    </record>
</odoo>

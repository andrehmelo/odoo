<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Check-Out Wizard Form -->
    <record id="view_vehicle_checkout_wizard_form" model="ir.ui.view">
        <field name="name">vehicle.checkout.wizard.form</field>
        <field name="model">vehicle.checkout.wizard</field>
        <field name="arch" type="xml">
            <form string="Check-Out Vehicle">
                <sheet>
                    <group>
                        <group string="Check-In Information" >
                            <field name="checkin_id" invisible="1"/>
                            <field name="driver_id"/>
                            <field name="vehicle_id"/>
                        </group>
                        <group string="Check-Out Details">
                            <field name="checkout_date"/>
                            <field name="checkout_mileage"/>
                        </group>
                    </group>
                    
                    <group>
                        <group string="Vehicle Status">
                            <field name="fuel_level"/>
                            <field name="vehicle_condition"/>
                        </group>
                        <group string="Damage Report" invisible="vehicle_condition not in ['poor', 'damaged']">
                            <field name="damage_description" nolabel="1" placeholder="Describe any damage..."/>
                        </group>
                    </group>
                    
                    <group string="Notes">
                        <field name="notes" nolabel="1" placeholder="Enter any additional notes..."/>
                    </group>
                </sheet>
                <footer>
                    <button string="Confirm Check-Out" name="action_confirm_checkout" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>

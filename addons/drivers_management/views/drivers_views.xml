<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- List View -->
    <record id="view_driver_list" model="ir.ui.view">
        <field name="name">driver.list</field>
        <field name="model">drivers.management</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="email"/>
                <field name="nr_telemovel"/>
                <field name="status"/>
                <field name="vehicle_id"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_driver_form" model="ir.ui.view">
        <field name="name">driver.form</field>
        <field name="model">drivers.management</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="status" widget="statusbar" options="{'clickable': '1'}" 
                           statusbar_visible="lead,active,inactive"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Driver Name"/>
                        </h1>
                    </div>
                    <notebook>
                        <!-- Personal Information Tab -->
                        <page string="Personal Information">
                            <group>
                                <field name="email"/>
                                <field name="nr_telemovel"/>
                                <field name="nif"/>
                                <field name="iban"/>
                            </group>
                        </page>

                        <!-- Uber Platform Tab -->
                        <page string="Uber Platform">
                            <group>
                                <group string="Uber Account">
                                    <field name="id_uber"/>
                                    <field name="nome_uber"/>
                                </group>
                                <group string="Uber Contact">
                                    <field name="email_uber"/>
                                    <field name="nr_telemovel_uber"/>
                                </group>
                            </group>
                        </page>

                        <!-- Bolt Platform Tab -->
                        <page string="Bolt Platform">
                            <group>
                                <group string="Bolt Account">
                                    <field name="id_bolt"/>
                                    <field name="nome_bolt"/>
                                </group>
                                <group string="Bolt Contact">
                                    <field name="email_bolt"/>
                                    <field name="nr_telemovel_bolt"/>
                                </group>
                            </group>
                        </page>

                        <!-- Vehicle Tab -->
                        <page string="Vehicle Assignment">
                            <group>
                                <field name="vehicle_id"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_driver_search" model="ir.ui.view">
        <field name="name">driver.search</field>
        <field name="model">drivers.management</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="email"/>
                <field name="nr_telemovel"/>
                <field name="nif"/>
                <filter string="Lead" name="filter_lead" domain="[('status','=','lead')]"/>
                <filter string="Active" name="filter_active" domain="[('status','=','active')]"/>
                <filter string="Inactive" name="filter_inactive" domain="[('status','=','inactive')]"/>
                <separator/>
                <filter string="Assigned Vehicle" name="filter_vehicle" domain="[('vehicle_id','!=',False)]"/>
                <separator/>
                <group expand="0" string="Group By">
                    <filter string="Status" name="group_status" context="{'group_by':'status'}"/>
                    <filter string="Vehicle" name="group_vehicle" context="{'group_by':'vehicle_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Kanban View -->
    <record id="view_driver_kanban" model="ir.ui.view">
        <field name="name">driver.kanban</field>
        <field name="model">drivers.management</field>
        <field name="arch" type="xml">
            <kanban default_group_by="status">
                <field name="id"/>
                <field name="name"/>
                <field name="email"/>
                <field name="nr_telemovel"/>
                <field name="status"/>
                <field name="vehicle_id"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong class="o_kanban_record_title">
                                    <field name="name"/>
                                </strong>
                                <div class="o_kanban_record_subtitle">
                                    <field name="email"/>
                                </div>
                                <div class="o_kanban_record_bottom">
                                    <div class="oe_kanban_bottom_left">
                                        <field name="nr_telemovel"/>
                                    </div>
                                    <div class="oe_kanban_bottom_right">
                                        <field name="vehicle_id"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
</odoo>
<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_drivers" model="ir.module.category">
        <field name="name">Drivers Management</field>
        <field name="description">User access level for Drivers Management</field>
        <field name="sequence">20</field>
    </record>

    <data noupdate="1">
        <!-- Security Groups -->
        <record id="group_drivers_user" model="res.groups">
            <field name="name">Drivers User</field>
            <field name="category_id" ref="base.module_category_human_resources"/>
        </record>

        <record id="group_drivers_manager" model="res.groups">
            <field name="name">Drivers Manager</field>
            <field name="category_id" ref="base.module_category_human_resources"/>
            <field name="implied_ids" eval="[(4, ref('group_drivers_user'))]"/>
        </record>
    </data>

    <record id="base.group_user" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('drivers_management.group_drivers_user'))]"/>
    </record>
</odoo>
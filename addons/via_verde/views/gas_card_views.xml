<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="gas_card_sheet_view_tree" model="ir.ui.view">
            <field name="name">gas.card.sheet.tree</field>
            <field name="model">gas.card.sheet</field>
            <field name="arch" type="xml">
                <list string="Gas Card Statements" sample="1" decoration-success="total_outstanding_amount == 0">
                    <field name="name"/>
                    <field name="reference" optional="show"/>
                    <field name="date"/>
                    <field name="company_id" groups="base.group_multi_company" optional="hide"/>
                    <field name="total_liters" optional="show"/>
                    <field name="total_amount" widget="monetary" optional="show"/>
                    <field name="total_outstanding_amount" widget="monetary" optional="show"/>
                </list>
            </field>
        </record>

        <record id="gas_card_sheet_view_search" model="ir.ui.view">
            <field name="name">gas.card.sheet.search</field>
            <field name="model">gas.card.sheet</field>
            <field name="arch" type="xml">
                <search string="Search Gas Card Statements">
                    <field name="name"/>
                    <field name="reference"/>
                    <filter name="outstanding" string="With Outstanding" domain="[('total_outstanding_amount', '>', 0)]"/>
                    <filter name="filter_date" date="date"/>
                    <group expand="0" string="Group By">
                        <filter string="Company" name="group_company" context="{'group_by': 'company_id'}"/>
                        <filter string="Date" name="group_date" context="{'group_by': 'date'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record id="gas_card_line_view_tree" model="ir.ui.view">
            <field name="name">gas.card.line.tree</field>
            <field name="model">gas.card.line</field>
            <field name="arch" type="xml">
                <list string="Gas Card Transactions" editable="bottom" multi_edit="1" sample="1">
                    <field name="sheet_id" optional="hide"/>
                    <field name="transaction_date"/>
                    <field name="transaction_time" optional="show"/>
                    <field name="card_number"/>
                    <field name="card_description" optional="show"/>
                    <field name="client_name" optional="show"/>
                    <field name="vehicle_id" widget="many2one_avatar" optional="show"/>
                    <field name="license_plate" optional="hide"/>
                    <field name="driver_id" widget="many2one_avatar" optional="show"/>
                    <field name="fuel_type" optional="show"/>
                    <field name="liters" optional="show"/>
                    <field name="net_amount" widget="monetary"/>
                    <field name="total_amount" widget="monetary" optional="show"/>
                    <field name="kilometers" optional="show"/>
                    <field name="is_paid" widget="boolean_toggle" optional="show"/>
                    <field name="amount_due" widget="monetary" optional="show"/>
                    <field name="station_name" optional="hide"/>
                    <field name="network_type" optional="hide"/>
                    <field name="payment_date" optional="hide"/>
                    <field name="receipt_number" optional="hide"/>
                    <field name="invoice_number" optional="hide"/>
                    <field name="unit_of_measure" optional="hide"/>
                    <field name="unit_price_excl_vat" widget="monetary" optional="hide"/>
                    <field name="vat_amount" widget="monetary" optional="hide"/>
                    <field name="reference_amount" widget="monetary" optional="hide"/>
                    <field name="discount_amount" widget="monetary" optional="hide"/>
                    <field name="driver_identifier" optional="hide"/>
                    <field name="transaction_datetime" optional="hide"/>
                    <button name="action_view_details" type="object" icon="fa-plus" title="Show full details" string=""/>
                </list>
            </field>
        </record>

        <record id="gas_card_line_view_search" model="ir.ui.view">
            <field name="name">gas.card.line.search</field>
            <field name="model">gas.card.line</field>
            <field name="arch" type="xml">
                <search string="Search Gas Card Transactions">
                    <field name="license_plate"/>
                    <field name="vehicle_id"/>
                    <field name="driver_id"/>
                    <field name="sheet_id" string="Statement"/>
                    <filter name="pending" string="Pending Payment" domain="[('is_paid', '=', False)]"/>
                    <filter name="paid" string="Paid" domain="[('is_paid', '=', True)]"/>
                    <filter name="by_date" date="transaction_date"/>
                    <group expand="0" string="Group By">
                        <filter string="Vehicle" name="group_vehicle" context="{'group_by': 'vehicle_id'}"/>
                        <filter string="Driver" name="group_driver" context="{'group_by': 'driver_id'}"/>
                        <filter string="Station" name="group_station" context="{'group_by': 'station_name'}"/>
                        <filter string="Fuel" name="group_fuel" context="{'group_by': 'fuel_type'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record id="gas_card_line_view_form" model="ir.ui.view">
            <field name="name">gas.card.line.form</field>
            <field name="model">gas.card.line</field>
            <field name="arch" type="xml">
                <form string="Gas Card Transaction">
                    <sheet>
                        <group col="4">
                            <field name="sheet_id" readonly="1"/>
                            <field name="card_number"/>
                            <field name="card_description"/>
                            <field name="client_name"/>
                            <field name="is_paid" widget="boolean_toggle"/>
                        </group>
                        <group col="4" string="Usage">
                            <field name="transaction_date"/>
                            <field name="transaction_time"/>
                            <field name="station_name"/>
                            <field name="network_type"/>
                            <field name="vehicle_id" widget="many2one_avatar"/>
                            <field name="license_plate"/>
                            <field name="driver_id" widget="many2one_avatar"/>
                            <field name="driver_identifier"/>
                            <field name="kilometers"/>
                            <field name="transaction_datetime" optional="hide"/>
                        </group>
                        <group col="2" string="Fuel">
                            <field name="fuel_type"/>
                            <field name="liters"/>
                            <field name="unit_of_measure"/>
                            <field name="unit_price_excl_vat" widget="monetary"/>
                        </group>
                        <group col="2" string="Amounts">
                            <field name="net_amount" widget="monetary"/>
                            <field name="vat_amount" widget="monetary"/>
                            <field name="total_amount" widget="monetary"/>
                            <field name="reference_amount" widget="monetary"/>
                            <field name="discount_amount" widget="monetary"/>
                            <field name="amount_due" widget="monetary" readonly="1"/>
                        </group>
                        <group col="2" string="Documents">
                            <field name="receipt_number"/>
                            <field name="invoice_number"/>
                            <field name="payment_date"/>
                            <field name="notes" colspan="2"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="gas_card_sheet_view_form" model="ir.ui.view">
            <field name="name">gas.card.sheet.form</field>
            <field name="model">gas.card.sheet</field>
            <field name="arch" type="xml">
                <form string="Gas Card Statement">
                    <header>
                        <button string="Mark All Paid" type="object" name="action_mark_paid" class="btn-primary" visible="total_outstanding_amount != 0"/>
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <h1><field name="name"/></h1>
                        </div>
                        <group col="4">
                            <field name="reference"/>
                            <field name="date"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="total_liters" readonly="1"/>
                            <field name="total_amount" widget="monetary" readonly="1"/>
                            <field name="total_outstanding_amount" widget="monetary" readonly="1"/>
                        </group>
                        <field name="line_ids" readonly="1"/>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <record id="gas_card_action_sheets" model="ir.actions.act_window">
            <field name="name">Gas Card Statements</field>
            <field name="res_model">gas.card.sheet</field>
            <field name="view_mode">list,form</field>
            <field name="view_id" ref="gas_card_sheet_view_tree"/>
            <field name="search_view_id" ref="gas_card_sheet_view_search"/>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Import or log your fuel card statements.
                </p>
                <p>
                    Upload provider files or capture transactions manually to monitor fuel usage and payments per vehicle.
                </p>
            </field>
        </record>

        <record id="gas_card_action_lines" model="ir.actions.act_window">
            <field name="name">Gas Card Transactions</field>
            <field name="res_model">gas.card.line</field>
            <field name="view_mode">list,form</field>
            <field name="view_id" ref="gas_card_line_view_tree"/>
            <field name="search_view_id" ref="gas_card_line_view_search"/>
        </record>
    </data>
</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vehicle Delete Wizard Form View -->
    <record id="view_vehicle_delete_wizard_form" model="ir.ui.view">
        <field name="name">vehicle.delete.wizard.form</field>
        <field name="model">vehicle.delete.wizard</field>
        <field name="arch" type="xml">
            <form string="Bulk Delete Operations">
                <div class="alert alert-warning" role="alert">
                    <strong>Warning!</strong> These actions cannot be undone. Please review your selection carefully.
                </div>
                
                <group>
                    <field name="delete_type" widget="radio"/>
                </group>
                
                <group>
                    <label for="item_count" string="Impact:"/>
                    <field name="item_count" readonly="1" class="text-primary fw-bold"/>
                </group>
                
                <div class="alert alert-info" role="alert">
                    <strong>Options explained:</strong>
                    <ul class="mb-0">
                        <li><strong>Delete All Vehicles:</strong> Removes all vehicles and all maintenance records (current and completed).</li>
                        <li><strong>Remove Current Interventions:</strong> Removes active interventions, vehicles return to "Available" status.</li>
                        <li><strong>Remove Completed Maintenances:</strong> Deletes all completed maintenance records from history.</li>
                        <li><strong>Remove All Maintenances:</strong> Removes all maintenance records (current and completed), vehicles return to "Available".</li>
                    </ul>
                </div>
                
                <group>
                    <field name="confirm_delete" required="1"/>
                </group>
                
                <footer>
                    <button name="action_delete_vehicles" 
                            string="Execute" 
                            type="object" 
                            class="btn-danger"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Delete Wizard Action -->
    <record id="action_vehicle_delete_wizard" model="ir.actions.act_window">
        <field name="name">Bulk Delete Operations</field>
        <field name="res_model">vehicle.delete.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="view_id" ref="view_vehicle_delete_wizard_form"/>
    </record>


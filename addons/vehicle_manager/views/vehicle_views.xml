<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vehicle Tree View -->
    <record id="view_vehicle_tree" model="ir.ui.view">
        <field name="name">vehicle.vehicle.tree</field>
        <field name="model">vehicle.vehicle</field>
        <field name="arch" type="xml">
            <list string="Vehicles" default_order="name desc">
                <field name="name" string="Vehicle"/>
                <field name="make"/>
                <field name="model"/>
                <field name="year"/>
                <field name="vin"/>
                <field name="license_plate"/>
                <field name="color"/>
                <field name="body_type"/>
                <field name="mileage"/>
                <field name="mileage_unit"/>
                <field name="condition"/>
                <field name="status" widget="badge" 
                       decoration-success="status in ['available']"
                       decoration-info="status in ['reserved']"
                       decoration-warning="status in ['maintenance']"/>
                <field name="current_value" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                <field name="currency_id" invisible="1"/>
                <field name="location"/>
                <field name="purchase_date"/>
                <field name="age" string="Age (Years)"/>
            </list>
        </field>
    </record>

    <!-- Vehicle Form View -->
    <record id="view_vehicle_form" model="ir.ui.view">
        <field name="name">vehicle.vehicle.form</field>
        <field name="model">vehicle.vehicle</field>
        <field name="arch" type="xml">
            <form string="Vehicle" class="o_vehicle_form">
                <header>
                    <!-- Status buttons -->
                    <button name="action_set_available" string="Set Available" 
                            type="object" class="btn-success"
                            invisible="status == 'available'"/>
                    <button name="action_set_reserved" string="Set Reserved" 
                            type="object" class="btn-warning"
                            invisible="status == 'reserved'"/>

                    <button name="action_set_maintenance" string="Send to Maintenance" 
                            type="object" class="btn-info"
                            invisible="status == 'maintenance'"/>
                    
                    <field name="status" widget="statusbar" 
                           statusbar_visible="available,reserved,maintenance"/>
                </header>
                
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <!-- Space for future action buttons -->
                    </div>
                    
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1" class="oe_inline"/>
                        </h1>
                    </div>
                    
                    <group>
                        <group name="basic_info" string="Basic Information">
                            <field name="make" required="1"/>
                            <field name="model" required="1"/>
                            <field name="year" required="1"/>
                            <field name="vin"/>
                            <field name="license_plate"/>
                            <field name="color"/>
                            <field name="body_type"/>
                        </group>
                        
                        <group name="physical" string="Physical Details">
                            <field name="doors"/>
                            <field name="seats"/>
                            <field name="condition"/>
                            <field name="age" readonly="1"/>
                        </group>
                    </group>
                    
                    <group>
                        <group name="engine" string="Engine &amp; Performance">
                            <field name="engine_size"/>
                            <field name="engine_type"/>
                            <field name="transmission"/>
                            <field name="drivetrain"/>
                        </group>
                        
                        <group name="mileage_condition" string="Mileage &amp; Usage">
                            <label for="mileage"/>
                            <div class="o_row">
                                <field name="mileage" class="oe_inline"/>
                                <field name="mileage_unit" class="oe_inline" nolabel="1"/>
                            </div>
                            <field name="location"/>
                        </group>
                    </group>
                    
                    <group>
                        <group name="financial" string="Financial Information">
                            <field name="currency_id" invisible="1"/>
                            <field name="purchase_price" widget="monetary" 
                                   options="{'currency_field': 'currency_id'}"/>
                            <field name="current_value" widget="monetary" 
                                   options="{'currency_field': 'currency_id'}"/>

                        </group>
                        
                        <group name="dates" string="Important Dates">
                            <field name="purchase_date"/>
                        </group>
                    </group>
                    
                    <group name="contact" string="Contact Information">
                        <field name="owner_id"/>
                    </group>
                    
                    <notebook>
                        <page name="features" string="Features &amp; Options">
                            <field name="features" placeholder="List special features, options, and equipment..."/>
                        </page>
                        
                        <page name="notes" string="Notes">
                            <field name="notes" placeholder="Additional notes about the vehicle..."/>
                        </page>
                    </notebook>
                </sheet>
                
                <div class="oe_chatter" style="min-width: 100%;">
                    <field name="message_follower_ids" options="{'open_attachments': True}"/>
                    <field name="activity_ids"/>
                    <field name="message_ids" options="{'post_refresh': 'recipients', 'display_log_button': True}"/>
                </div>
            </form>
        </field>
    </record>

    <!-- Vehicle Kanban View -->
    <record id="view_vehicle_kanban" model="ir.ui.view">
        <field name="name">vehicle.vehicle.kanban</field>
        <field name="model">vehicle.vehicle</field>
        <field name="arch" type="xml">
                    <kanban default_group_by="status" class="o_kanban_small_column" group_create="false" group_edit="false" group_delete="false" groups_limit="200">
            <field name="color"/>
            <field name="id"/>
            <field name="name"/>
            <field name="make"/>
            <field name="model"/>
            <field name="year"/>
            <field name="status"/>
            <field name="purchase_price"/>
            <field name="mileage"/>
            <field name="condition"/>
            <field name="description"/>
            <progressbar field="status" colors='{"available": "success", "reserved": "warning", "maintenance": "danger"}'/>
            <templates>
                <t t-name="kanban-box">
                    <div class="oe_kanban_global_click">
                        <div class="o_kanban_record_top mb16">
                            <div class="o_kanban_record_headings">
                                <strong class="o_kanban_record_title">
                                    <span><field name="name"/></span>
                                </strong>
                            </div>
                        </div>
                        <div class="o_kanban_record_body">
                            <div class="text-muted">
                                <field name="make"/> <field name="model"/> (<field name="year"/>)
                            </div>
                            <div class="text-muted">
                                Condition: <field name="condition"/>
                            </div>
                            <div class="text-muted">
                                Mileage: <field name="mileage"/> km
                            </div>
                            <div class="text-muted">
                                Price: €<field name="purchase_price"/>
                            </div>
                        </div>
                        <div class="o_kanban_record_bottom">
                            <div class="oe_kanban_bottom_left text-muted">
                                <span t-if="record.description.raw_value">
                                    <field name="description"/>
                                </span>
                            </div>
                        </div>
                    </div>
                </t>
            </templates>
        </kanban>
        </field>
    </record>

    <!-- Vehicle Search View -->
    <record id="view_vehicle_search" model="ir.ui.view">
        <field name="name">vehicle.vehicle.search</field>
        <field name="model">vehicle.vehicle</field>
        <field name="arch" type="xml">
            <search string="Search Vehicles">
                <field name="name" string="Vehicle" 
                       filter_domain="['|', '|', '|', ('name', 'ilike', self), ('make', 'ilike', self), ('model', 'ilike', self), ('vin', 'ilike', self)]"/>
                <field name="make"/>
                <field name="model"/>
                <field name="year"/>
                <field name="vin"/>
                <field name="license_plate"/>
                <field name="color"/>
                <field name="location"/>
                <field name="owner_id"/>
                
                <!-- Filters -->
                <separator/>
                <filter name="available" string="Available" 
                        domain="[('status', '=', 'available')]"/>
                <filter name="reserved" string="Reserved" 
                        domain="[('status', '=', 'reserved')]"/>
                <filter name="maintenance" string="In Maintenance" 
                        domain="[('status', '=', 'maintenance')]"/>
                
                <separator/>
                <filter name="new_condition" string="New" 
                        domain="[('condition', '=', 'new')]"/>
                <filter name="excellent_condition" string="Excellent" 
                        domain="[('condition', '=', 'excellent')]"/>
                <filter name="good_condition" string="Good" 
                        domain="[('condition', '=', 'good')]"/>
                
                <separator/>
                <filter name="recent_years" string="Recent (2020+)" 
                        domain="[('year', '>=', 2020)]"/>
                <filter name="low_mileage" string="Low Mileage (&lt;50k)" 
                        domain="[('mileage', '&lt;', 50000)]"/>
                
                <!-- Group By -->
                <group expand="0" string="Group By">
                    <filter name="group_status" string="Status" 
                            context="{'group_by': 'status'}"/>
                    <filter name="group_make" string="Make" 
                            context="{'group_by': 'make'}"/>
                    <filter name="group_year" string="Year" 
                            context="{'group_by': 'year'}"/>
                    <filter name="group_condition" string="Condition" 
                            context="{'group_by': 'condition'}"/>
                    <filter name="group_body_type" string="Body Type" 
                            context="{'group_by': 'body_type'}"/>
                    <filter name="group_location" string="Location" 
                            context="{'group_by': 'location'}"/>
                </group>
            </search>
        </field>
    </record>
</odoo>
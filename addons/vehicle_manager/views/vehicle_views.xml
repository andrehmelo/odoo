<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vehicle Tree View -->
    <record id="view_vehicle_tree" model="ir.ui.view">
        <field name="name">vehicle.vehicle.tree</field>
        <field name="model">vehicle.vehicle</field>
        <field name="arch" type="xml">
            <list string="Vehicles" default_order="name desc">
                <field name="name" string="Vehicle"/>
                <field name="make"/>
                <field name="model"/>
                <field name="year" sum="" avg=""/>
                <field name="vin"/>
                <field name="license_plate"/>
                <field name="mileage" sum="" avg=""/>
                <field name="condition"/>
                <field name="status" widget="badge" 
                       decoration-success="status in ['available']"
                       decoration-info="status in ['reserved']"
                       decoration-warning="status in ['maintenance']"/>
                <field name="age" string="Age (Years)" sum="" avg=""/>
            </list>
        </field>
    </record>

    <!-- Vehicle Form View -->
    <record id="view_vehicle_form" model="ir.ui.view">
        <field name="name">vehicle.vehicle.form</field>
        <field name="model">vehicle.vehicle</field>
        <field name="arch" type="xml">
            <form string="Vehicle" class="o_vehicle_form">
                <header>
                    <!-- Status buttons -->
                    <button name="action_set_available" string="✅ Complete Maintenance" 
                            type="object" class="btn-success"
                            invisible="status != 'maintenance'"
                            help="Complete maintenance and make vehicle available"/>
                    <button name="action_set_reserved" string="📋 Set Reserved" 
                            type="object" class="btn-warning"
                            invisible="status == 'reserved' or status == 'maintenance'"
                            help="Mark vehicle as reserved"/>

                    <button name="action_set_maintenance" string="🔧 Send to Maintenance" 
                            type="object" class="btn-info"
                            invisible="status != 'available'"
                            help="Send vehicle to maintenance workshop"/>
                    
                    <button name="action_remove_maintenance" 
                            string="Remove Maintenance" 
                            type="object" 
                            class="btn-warning"
                            data-hotkey="r"
                            invisible="status != 'maintenance'"
                            confirm="Are you sure you want to remove this maintenance intervention? The vehicle will be set as available."
                            help="Remove current maintenance intervention and set vehicle as available"/>
                    
                    <button name="action_delete_vehicle" 
                            string="Delete Vehicle" 
                            type="object" 
                            class="btn-danger"
                            data-hotkey="shift+d"
                            invisible="status != 'available'"
                            confirm="Are you sure you want to delete this vehicle? This action cannot be undone."
                            help="Permanently delete this vehicle"/>
                    
                    <field name="status" widget="statusbar" 
                           statusbar_visible="available,reserved,maintenance"/>
                </header>
                
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <!-- Space for future action buttons -->
                    </div>
                    
                    <div class="oe_title">
                        <label for="name" string="Car Name" class="oe_edit_only"/>
                        <h1>
                            <field name="name" class="oe_inline" placeholder="Enter vehicle name..."/>
                        </h1>
                    </div>
                    
                    <group>
                        <group name="basic_info" string="Basic Information">
                            <field name="make" placeholder="e.g. Toyota, BMW, Ford..."/>
                            <field name="model" placeholder="e.g. Camry, 320i, F-150..."/>
                            <field name="vin" placeholder="Vehicle Identification Number"/>
                            <field name="license_plate" class="oe_inline" placeholder="License Plate"/>
                            <field name="color" class="oe_inline" placeholder="e.g. Blue, Red, Silver..."/>
                            <field name="year" class="oe_inline"/>
                        </group>
                        
                        <group name="driver_fees" string="Driver Fees">
                            <field name="weekly_rent" class="oe_inline" placeholder="0.00"/>
                            <field name="entry_deposit" class="oe_inline" placeholder="0.00"/>
                            <field name="reserve_fee" class="oe_inline" placeholder="0.00"/>
                            <field name="reserve_fee_max" class="oe_inline" placeholder="0.00"/>
                        </group>
                    </group>
                    
                    <group>
                        <group name="financial" string="Financial Information">
                            <field name="purchase_price" class="oe_inline" placeholder="0.00"/>
                            <field name="current_value" class="oe_inline" placeholder="0.00"/>
                            <field name="purchase_date" class="oe_inline"/>
                        </group>
                        
                                                <group name="physical" string="Car Details">
                            <field name="via_verde_card" class="oe_inline" placeholder="Via Verde card number"/>
                            <field name="gas_card" class="oe_inline" placeholder="Gas payment card number"/>
                            <field name="fire_extinguisher" class="oe_inline" placeholder="Fire extinguisher ID"/>
                            <field name="insurance_date" class="oe_inline"/>
                            <field name="ipo_date" class="oe_inline"/>
                            <field name="condition" class="oe_inline"/>
                            <field name="age" class="oe_inline" readonly="1"/>
                        </group>
                    </group>
                    
                    <group>
                        <group name="mileage_condition" string="Mileage &amp; Usage">
                            <label for="mileage"/>
                            <div class="o_row">
                                <field name="mileage" class="oe_inline"/>
                                <field name="mileage_unit" class="oe_inline" nolabel="1"/>
                            </div>
                            <field name="location" placeholder="Current location or address"/>
                        </group>
                        
                        <group></group>
                    </group>
                    
                    <group name="contact" string="Contact Information">
                        <field name="owner_id"/>
                    </group>
                    
                    <!-- Current Intervention Information (only visible when in maintenance) -->
                    <group name="current_intervention" string="Current Intervention" invisible="status != 'maintenance'">
                        <field name="current_intervention_id" invisible="1"/>
                        <group name="intervention_details" string="Intervention Details" invisible="not current_intervention_id">
                            <field name="current_intervention_id" readonly="1" options="{'no_create': True}"/>
                            <field name="current_intervention_entry_date" readonly="1"/>
                            <field name="current_intervention_days" readonly="1"/>
                            <field name="current_intervention_location" readonly="1"/>
                            <field name="current_intervention_notes" readonly="1"/>
                        </group>
                        <div invisible="current_intervention_id" class="alert alert-info" role="alert">
                            <p>No active intervention found. This might indicate a data inconsistency.</p>
                        </div>
                    </group>
                    
                    <notebook>
                        <page name="features" string="Features &amp; Options">
                            <field name="features" placeholder="List special features, options, and equipment..."/>
                        </page>
                        
                        <page name="notes" string="Notes">
                            <field name="notes" placeholder="Additional notes about the vehicle..."/>
                        </page>
                        
                        <page name="intervention_history" string="Intervention History">
                            <field name="intervention_ids"/>
                        </page>
                        
                        <page name="history" string="Car History">
                            <group>
                                <group name="creation_info" string="Creation Information">
                                    <field name="created_by_name" readonly="1"/>
                                    <field name="create_date" string="Created On" readonly="1"/>
                                </group>
                                
                                <group name="modification_info" string="Last Modification">
                                    <field name="last_modified_by_name" readonly="1"/>
                                    <field name="write_date" string="Last Modified On" readonly="1"/>
                                </group>
                            </group>
                            
                            <separator string="Record Information"/>
                            <group>
                                <group>
                                    <field name="id" string="Record ID" readonly="1"/>
                                    <field name="active" readonly="1"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Vehicle Kanban View with Tabbed Layout -->
    <record id="view_vehicle_kanban" model="ir.ui.view">
        <field name="name">vehicle.vehicle.kanban</field>
        <field name="model">vehicle.vehicle</field>
        <field name="arch" type="xml">
            <kanban class="o_vehicle_kanban_view" default_group_by="status" default_order="sequence, name desc, id desc" records_draggable="false" group_create="false" quick_create="false">
                <field name="sequence"/>
                <field name="id"/>
                <field name="name"/>
                <field name="make"/>
                <field name="model"/>
                <field name="year"/>
                <field name="status"/>
                <field name="vin"/>
                <field name="condition"/>
                <field name="description"/>
                <field name="license_plate"/>
                <field name="color"/>
                
                <templates>
                    <!-- Status Tab Navigation -->
                    <t t-name="view">
                        <div class="o_vehicle_status_tabs">
                            <div class="d-flex border-bottom mb-3 btn-group" role="group">
                                <button class="btn btn-success flex-fill status-tab" data-status="available" name="available_tab" type="button">
                                    <i class="fa fa-check-circle me-2" title="Available"/>
                                    Available
                                    <span class="badge bg-light text-dark ms-2" t-att-data-count="available">0</span>
                                </button>
                                <button class="btn btn-warning flex-fill status-tab" data-status="reserved" name="reserved_tab" type="button">
                                    <i class="fa fa-clock-o me-2" title="Reserved"/>
                                    Reserved  
                                    <span class="badge bg-light text-dark ms-2" t-att-data-count="reserved">0</span>
                                </button>
                                <button class="btn btn-danger flex-fill status-tab" data-status="maintenance" name="maintenance_tab" type="button">
                                    <i class="fa fa-wrench me-2" title="In Maintenance"/>
                                    In Maintenance
                                    <span class="badge bg-light text-dark ms-2" t-att-data-count="maintenance">0</span>
                                </button>
                            </div>
                        </div>
                        <div class="o_vehicle_cards_container">
                            <t t-call="default"/>
                        </div>
                    </t>
                    
                    <!-- Vehicle Card Template -->
                    <t t-name="card">
                        <div class="o_vehicle_card" t-att-data-status="record.status.raw_value">
                            <div class="card h-100">
                                <!-- Card Header -->
                                <div class="card-header d-flex justify-content-between align-items-center">
                                    <h6 class="card-title mb-0 text-primary">
                                        <field name="name"/>
                                    </h6>
                                    <!-- Action Buttons -->
                                    <div class="dropdown">
                                        <button class="btn btn-sm btn-outline-secondary dropdown-toggle" data-bs-toggle="dropdown" type="button" name="action_dropdown">
                                            <i class="fa fa-cog" title="Actions"/>
                                        </button>
                                        <div class="dropdown-menu dropdown-menu-end" role="menu">
                                            <!-- Available Status Actions -->
                                            <button name="action_set_maintenance" type="object" 
                                                    class="dropdown-item btn-link text-start"
                                                    t-if="record.status.raw_value == 'available'">
                                                <i class="fa fa-wrench text-info me-2"/>
                                                Send to Maintenance
                                            </button>
                                            <button name="action_set_reserved" type="object" 
                                                    class="dropdown-item btn-link text-start"
                                                    t-if="record.status.raw_value == 'available'">
                                                <i class="fa fa-clock-o text-warning me-2"/>
                                                Set Reserved
                                            </button>
                                            
                                            <!-- Reserved Status Actions -->
                                            <button name="action_set_available" type="object" 
                                                    class="dropdown-item btn-link text-start"
                                                    t-if="record.status.raw_value == 'reserved'">
                                                <i class="fa fa-check-circle text-success me-2"/>
                                                Set Available
                                            </button>
                                            
                                            <!-- Maintenance Status Actions -->
                                            <button name="action_set_available" type="object" 
                                                    class="dropdown-item btn-link text-start"
                                                    t-if="record.status.raw_value == 'maintenance'">
                                                <i class="fa fa-check-circle text-success me-2"/>
                                                Complete Maintenance
                                            </button>
                                            
                                            <button name="action_remove_maintenance" type="object" 
                                                    class="dropdown-item btn-link text-start"
                                                    t-if="record.status.raw_value == 'maintenance'"
                                                    confirm="Are you sure you want to remove this maintenance intervention? The vehicle will be set as available.">
                                                <i class="fa fa-trash text-warning me-2"/>
                                                Remove Maintenance
                                            </button>
                                            
                                            <!-- Common Actions -->
                                            <div class="dropdown-divider"></div>
                                            <button name="open_form_view" type="object" 
                                                    class="dropdown-item btn-link text-start">
                                                <i class="fa fa-eye text-primary me-2"/>
                                                View Details
                                            </button>
                                            
                                            <!-- Delete Vehicle (only when available) -->
                                            <button name="action_delete_vehicle" type="object" 
                                                    class="dropdown-item btn-link text-start"
                                                    t-if="record.status.raw_value == 'available'"
                                                    confirm="Are you sure you want to delete this vehicle? This action cannot be undone.">
                                                <i class="fa fa-trash text-danger me-2"/>
                                                Delete Vehicle
                                            </button>
                                        </div>
                                    </div>
                                </div>
                                
                                <!-- Card Body -->
                                <div class="card-body">
                                    <div class="row">
                                        <div class="col-7">
                                            <div class="text-muted mb-1">
                                                <strong><field name="make"/> <field name="model"/></strong>
                                            </div>
                                            <div class="text-muted mb-1">
                                                <i class="fa fa-car me-1" title="Condition"/>
                                                <field name="condition" class="condition-text"/>
                                            </div>
                                            <div class="text-muted mb-1">
                                                <i class="fa fa-calendar me-1" title="Year"/>
                                                <field name="year"/>
                                            </div>
                                            <div class="text-muted mb-0 vin-container" t-if="record.vin.raw_value">
                                                <i class="fa fa-barcode me-1" title="VIN"/>
                                                <field name="vin" class="vin-text" t-att-title="record.vin.raw_value"/>
                                            </div>
                                        </div>
                                        <div class="col-5 text-end">
                                            <p class="text-muted mb-2" t-if="record.license_plate.raw_value">
                                                <strong><field name="license_plate"/></strong>
                                            </p>
                                            <div t-att-class="'badge ' + (record.status.raw_value == 'available' ? 'bg-success' : record.status.raw_value == 'reserved' ? 'bg-warning' : 'bg-danger')">
                                                <field name="status"/>
                                            </div>
                                        </div>
                                    </div>
                                    
                                    <div class="mt-2" t-if="record.description.raw_value">
                                        <p class="text-muted small mb-0">
                                            <field name="description"/>
                                        </p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Vehicle Search View -->
    <record id="view_vehicle_search" model="ir.ui.view">
        <field name="name">vehicle.vehicle.search</field>
        <field name="model">vehicle.vehicle</field>
        <field name="arch" type="xml">
            <search string="Search Vehicles">
                <field name="name" string="Vehicle" 
                       filter_domain="['|', '|', '|', ('name', 'ilike', self), ('make', 'ilike', self), ('model', 'ilike', self), ('vin', 'ilike', self)]"/>
                <field name="make"/>
                <field name="model"/>
                <field name="year"/>
                <field name="vin"/>
                <field name="license_plate"/>
                <field name="color"/>
                <field name="location"/>
                <field name="owner_id"/>
                
                <!-- Filters -->
                <separator/>
                <filter name="available" string="Available" 
                        domain="[('status', '=', 'available')]"/>
                <filter name="reserved" string="Reserved" 
                        domain="[('status', '=', 'reserved')]"/>
                <filter name="maintenance" string="In Maintenance" 
                        domain="[('status', '=', 'maintenance')]"/>
                
                <separator/>
                <filter name="new_condition" string="New" 
                        domain="[('condition', '=', 'new')]"/>
                <filter name="excellent_condition" string="Excellent" 
                        domain="[('condition', '=', 'excellent')]"/>
                <filter name="good_condition" string="Good" 
                        domain="[('condition', '=', 'good')]"/>
                
                <separator/>
                <filter name="recent_years" string="Recent (2020+)" 
                        domain="[('year', '>=', 2020)]"/>
                <filter name="low_mileage" string="Low Mileage (&lt;50k)" 
                        domain="[('mileage', '&lt;', 50000)]"/>
                
                <!-- Group By -->
                <group expand="0" string="Group By">
                    <filter name="group_status" string="Status" 
                            context="{'group_by': 'status'}"/>
                    <filter name="group_make" string="Make" 
                            context="{'group_by': 'make'}"/>
                    <filter name="group_year" string="Year" 
                            context="{'group_by': 'year'}"/>
                    <filter name="group_condition" string="Condition" 
                            context="{'group_by': 'condition'}"/>
                    <filter name="group_location" string="Location" 
                            context="{'group_by': 'location'}"/>
                </group>
            </search>
        </field>
    </record>
</odoo>